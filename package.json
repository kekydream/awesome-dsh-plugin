{
  "name": "dsh-meeting-room",
  "version": "0.1.0-preview.3",
  "description": "会议记录：本机转写、发言人分离、要点与工作安排、手写笔记、复盘与纪要 · Meeting notes inside DeepSeek Harness",
  "author": "杨道泉 <yangdaoquan@qq.com> (博尔塔拉融媒体中心媒体传播与认知重点实验室)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/kekydream/dsh-meeting-room.git"
  },
  "homepage": "https://gitee.com/kekydream/dsh-meeting-room#readme",
  "bugs": {
    "url": "https://gitee.com/kekydream/dsh-meeting-room/issues",
    "email": "yangdaoquan@qq.com"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "meeting",
    "minutes",
    "transcription",
    "speaker-diarization",
    "handwriting",
    "会议记录",
    "会议纪要",
    "转写",
    "发言人分离"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "host-*.js",
    "speaker-worker.js",
    "handwriting-worker.js",
    "minutes-docx.py",
    "scores-xlsx.py",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "MODELS.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "DESIGN.md",
    "FEATURES.md",
    "TESTING.md",
    "smoke.mjs"
  ],
  "license": "MIT",
  "dependencies": {
    "onnxruntime-node": "1.20.1",
    "pinyin-pro": "^3.27.0"
  },
  "peerDependencies": {
    "sherpa-onnx-node": "1.13.8"
  },
  "peerDependenciesMeta": {
    "sherpa-onnx-node": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
